+                return $this->result_error( '没有可更新的新版本。' );
+            }
+
+            require_once ABSPATH . 'wp-admin/includes/file.php';
+
+            global $wp_filesystem;
+            if ( ! WP_Filesystem() || ! is_object( $wp_filesystem ) ) {
+                return $this->result_error( '初始化 WP_Filesystem 失败，请检查插件目录写入权限或文件系统凭据。' );
+            }
+
+            $upgrade_dir = trailingslashit( WP_CONTENT_DIR ) . 'upgrade';
+            $work_dir    = trailingslashit( $upgrade_dir ) . 'xjpe_update_' . wp_generate_uuid4();
+            $extract_dir = trailingslashit( $work_dir ) . 'extract';
+            $backup_dir  = trailingslashit( $work_dir ) . 'backup';
+
+            if ( ! $wp_filesystem->is_dir( $upgrade_dir ) && ! $wp_filesystem->mkdir( $upgrade_dir, FS_CHMOD_DIR ) ) {
+                return $this->result_error( '无法创建 wp-content/upgrade 目录。' );
+            }
+            if ( ! $wp_filesystem->mkdir( $work_dir, FS_CHMOD_DIR ) ||
+                ! $wp_filesystem->mkdir( $extract_dir, FS_CHMOD_DIR ) ||
+                ! $wp_filesystem->mkdir( $backup_dir, FS_CHMOD_DIR ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '创建更新临时目录失败。' );
+            }
+
+            $zip_path = download_url( $this->zip_url( $settings ), 60 );
+            if ( is_wp_error( $zip_path ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '下载失败：' . $zip_path->get_error_message() );
+            }
+
+            $unzipped = unzip_file( $zip_path, $extract_dir );
+            @unlink( $zip_path );
+            if ( is_wp_error( $unzipped ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '解压失败：' . $unzipped->get_error_message() );
+            }
+
+            $inner = $this->find_extracted_root( $extract_dir, $settings['main_file'] );
+            if ( ! $inner ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '未在压缩包中找到插件主文件。' );
+            }
+
+            $validation = $this->validate_package( $inner, $settings, $info );
+            if ( is_wp_error( $validation ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( $validation->get_error_message() );
+            }
+
+            $settings_snapshot = get_option( XJPE_Plugin::OPTION_NAME, array() );
+            update_option(
+                'xjpe_options_backup',
+                array(
+                    'time'     => time(),
+                    'version'  => XJPE_Plugin::VERSION,
+                    'settings' => $settings_snapshot,
+                ),
+                false
+            );
+
+            $backup_result = copy_dir( $this->plugin_dir, $backup_dir );
+            if ( is_wp_error( $backup_result ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '备份当前插件文件失败：' . $backup_result->get_error_message() );
+            }
+            if ( ! $wp_filesystem->exists( trailingslashit( $backup_dir ) . $settings['main_file'] ) ) {
+                $this->cleanup_path( $work_dir );
+                return $this->result_error( '插件文件备份不完整，更新已中止。' );
+            }
+
+            $install_result = $this->install_package( $inner );
+            if ( is_wp_error( $install_result ) ) {
+                $rollback = $this->rollback( $backup_dir, $settings_snapshot );
+                $this->cleanup_path( $work_dir );
+                $message = '安装失败：' . $install_result->get_error_message();
+                if ( is_wp_error( $rollback ) ) {
+                    $message .= '；自动回滚也失败：' . $rollback->get_error_message();
+                } else {
+                    $message .= '；已自动恢复旧版本。';
+                }
+                return $this->result_error( $message );
+            }
+
+            $installed_main = trailingslashit( $this->plugin_dir ) . $settings['main_file'];
+            $installed_version = $this->parse_version_from_file( $installed_main );
+            if ( ! file_exists( $installed_main ) || $installed_version !== $info['latest_version'] ) {
+                $rollback = $this->rollback( $backup_dir, $settings_snapshot );
+                $this->cleanup_path( $work_dir );
+                $message = '安装后的文件校验失败。';
+                if ( is_wp_error( $rollback ) ) {
+                    $message .= ' 自动回滚也失败：' . $rollback->get_error_message();
+                } else {
+                    $message .= ' 已自动恢复旧版本。';
+                }
+                return $this->result_error( $message );
+            }
+
+            $after = get_option( XJPE_Plugin::OPTION_NAME, null );
+            if ( ( ! is_array( $after ) || empty( $after ) ) && is_array( $settings_snapshot ) ) {
+                update_option( XJPE_Plugin::OPTION_NAME, $settings_snapshot, false );
+            }
+
+            $this->cleanup_path( $work_dir );
+            return array(
+                'success'     => true,
+                'message'     => '已成功更新：v' . XJPE_Plugin::VERSION . ' → v' . $installed_version . '（配置已保留，旧文件已清理）。',
+                'old_version' => XJPE_Plugin::VERSION,
+                'new_version' => $installed_version,
+            );
+        }
+
+        protected function install_package( $source_dir ) {
+            global $wp_filesystem;
+
+            if ( ! $wp_filesystem->delete( $this->plugin_dir, true ) ) {
+                return new WP_Error( 'xjpe_delete_failed', '无法清理旧插件目录。' );
+            }
+            if ( ! $wp_filesystem->mkdir( $this->plugin_dir, FS_CHMOD_DIR ) && ! $wp_filesystem->is_dir( $this->plugin_dir ) ) {
+                return new WP_Error( 'xjpe_mkdir_failed', '无法重新创建插件目录。' );
+            }
+
+            $result = copy_dir( $source_dir, $this->plugin_dir );
+            if ( is_wp_error( $result ) ) {
+                return $result;
+            }
+            return true;
+        }
+
+        protected function rollback( $backup_dir, $settings_snapshot ) {
+            global $wp_filesystem;
+
+            $wp_filesystem->delete( $this->plugin_dir, true );
+            if ( ! $wp_filesystem->mkdir( $this->plugin_dir, FS_CHMOD_DIR ) && ! $wp_filesystem->is_dir( $this->plugin_dir ) ) {
+                return new WP_Error( 'xjpe_rollback_mkdir_failed', '无法重新创建插件目录。' );
+            }
+
+            $result = copy_dir( $backup_dir, $this->plugin_dir );
+            if ( is_wp_error( $result ) ) {
+                return $result;
+            }
+
+            if ( is_array( $settings_snapshot ) ) {
+                update_option( XJPE_Plugin::OPTION_NAME, $settings_snapshot, false );
+            }
+            return true;
+        }
+
+        protected function validate_package( $root, $settings, $info ) {
+            $main = trailingslashit( $root ) . $settings['main_file'];
+            if ( ! file_exists( $main ) || ! is_readable( $main ) ) {
+                return new WP_Error( 'xjpe_missing_main', '压缩包内主插件文件缺失或不可读。' );
+            }
+
+            $new_version = $this->parse_version_from_file( $main );
+            if ( '' === $new_version ) {
+                return new WP_Error( 'xjpe_missing_version', '新版本主文件没有 Version 头。' );
+            }
+            if ( $new_version !== $info['latest_version'] ) {
+                return new WP_Error( 'xjpe_version_mismatch', '压缩包版本与远程主文件版本不一致，更新中止。' );
+            }
+            if ( ! version_compare( $new_version, XJPE_Plugin::VERSION, '>' ) ) {
+                return new WP_Error( 'xjpe_not_newer', '下载到的版本不高于当前版本。' );
+            }
+
+            $main_hash = hash_file( 'sha256', $main );
+            if ( empty( $info['main_sha256'] ) || ! is_string( $main_hash ) || ! hash_equals( $info['main_sha256'], $main_hash ) ) {
+                return new WP_Error( 'xjpe_hash_mismatch', '压缩包主文件与远程版本文件校验值不一致。' );
+            }
+
+            $required = array(
+                'assets/css/frontend.css',
+                'assets/js/frontend.js',
+                'assets/css/admin.css',
+                'assets/js/admin.js',
+                'includes/class-xjpe-updater.php',
+                'readme.txt',
+                'uninstall.php',
+            );
+            foreach ( $required as $relative ) {
+                if ( ! file_exists( trailingslashit( $root ) . $relative ) ) {
+                    return new WP_Error( 'xjpe_incomplete_package', '更新包缺少必要文件：' . $relative );
+                }
+            }
+
+            return true;
+        }
+
+        protected function fetch_changelog_snippet( $settings ) {
+            $response = wp_remote_get(
+                $this->raw_readme_url( $settings ),
+                array(
+                    'timeout'     => 12,
+                    'redirection' => 5,
+                    'user-agent'  => 'WP-Page-Effects-Updater/' . XJPE_Plugin::VERSION,
+                )
+            );
+
+            if ( is_wp_error( $response ) || 200 !== (int) wp_remote_retrieve_response_code( $response ) ) {
+                return '';
+            }
+
+            $body = wp_remote_retrieve_body( $response );
+            if ( ! is_string( $body ) || '' === $body ) {
+                return '';
+            }
+
+            if ( preg_match( '/==\s*Changelog\s*==\s*(.+?)(\n==\s|\z)/su', $body, $match ) ) {
+                $snippet = trim( $match[1] );
+                if ( strlen( $snippet ) > 2000 ) {
+                    $snippet = substr( $snippet, 0, 2000 ) . "\n…";
+                }
+                return $snippet;
+            }
+
+            return '';
+        }
+
+        protected function get_update_settings() {
+            $defaults = array(
+                'enabled'      => 1,
+                'github_owner' => self::DEFAULT_GITHUB_OWNER,
+                'github_repo'  => self::DEFAULT_GITHUB_REPO,
+                'branch'       => self::DEFAULT_GITHUB_BRANCH,
+                'main_file'    => self::DEFAULT_MAIN_FILE,
+                'zip_url'      => '',
+            );
+
+            $saved = get_option( XJPE_Plugin::OPTION_NAME, array() );
+            $input = isset( $saved['update'] ) && is_array( $saved['update'] ) ? $saved['update'] : array();
+            $settings = array_merge( $defaults, $input );
+
+            $settings['enabled']      = empty( $settings['enabled'] ) ? 0 : 1;
+            $settings['github_owner'] = preg_replace( '/[^a-zA-Z0-9_.-]/', '', (string) $settings['github_owner'] ) ?: self::DEFAULT_GITHUB_OWNER;
+            $settings['github_repo']  = preg_replace( '/[^a-zA-Z0-9_.-]/', '', (string) $settings['github_repo'] ) ?: self::DEFAULT_GITHUB_REPO;
+            $settings['branch']       = trim( str_replace( '..', '', preg_replace( '/[^a-zA-Z0-9_.\/-]/', '', (string) $settings['branch'] ) ), '/' );
+            $settings['main_file']    = ltrim( str_replace( '..', '', preg_replace( '/[^a-zA-Z0-9_.\/-]/', '', (string) $settings['main_file'] ) ), '/' );
+            $settings['zip_url']      = esc_url_raw( (string) $settings['zip_url'] );
+
+            if ( '' === $settings['branch'] ) {
+                $settings['branch'] = self::DEFAULT_GITHUB_BRANCH;
+            }
+            if ( '' === $settings['main_file'] ) {
+                $settings['main_file'] = self::DEFAULT_MAIN_FILE;
+            }
+            return $settings;
+        }
+
+        protected function raw_main_url( $settings ) {
+            return sprintf(
+                'https://raw.githubusercontent.com/%s/%s/%s/%s',
+                rawurlencode( $settings['github_owner'] ),
+                rawurlencode( $settings['github_repo'] ),
+                $this->encode_path( $settings['branch'] ),
+                $this->encode_path( $settings['main_file'] )
+            );
+        }
+
+        protected function raw_readme_url( $settings ) {
+            return sprintf(
+                'https://raw.githubusercontent.com/%s/%s/%s/readme.txt',
+                rawurlencode( $settings['github_owner'] ),
+                rawurlencode( $settings['github_repo'] ),
+                $this->encode_path( $settings['branch'] )
+            );
+        }
+
+        protected function zip_url( $settings ) {
+            if ( ! empty( $settings['zip_url'] ) && 'https' === wp_parse_url( $settings['zip_url'], PHP_URL_SCHEME ) ) {
+                return $settings['zip_url'];
+            }
+            return sprintf(
+                'https://github.com/%s/%s/archive/refs/heads/%s.zip',
+                rawurlencode( $settings['github_owner'] ),
+                rawurlencode( $settings['github_repo'] ),
+                $this->encode_path( $settings['branch'] )
+            );
+        }
+
+        protected function encode_path( $path ) {
+            return implode( '/', array_map( 'rawurlencode', explode( '/', trim( (string) $path, '/' ) ) ) );
+        }
+
+        protected function find_extracted_root( $tmp_dir, $main_file ) {
+            $tmp_dir = untrailingslashit( $tmp_dir );
+            $direct  = trailingslashit( $tmp_dir ) . $main_file;
+            if ( file_exists( $direct ) ) {
+                return $tmp_dir;
+            }
+
+            try {
+                $iterator = new RecursiveIteratorIterator(
+                    new RecursiveDirectoryIterator( $tmp_dir, FilesystemIterator::SKIP_DOTS ),
+                    RecursiveIteratorIterator::SELF_FIRST
+                );
+                foreach ( $iterator as $item ) {
+                    if ( ! $item->isDir() || $iterator->getDepth() > 2 ) {
+                        continue;
+                    }
+                    $candidate = trailingslashit( $item->getPathname() ) . $main_file;
+                    if ( file_exists( $candidate ) ) {
+                        return $item->getPathname();
+                    }
+                }
+            } catch ( UnexpectedValueException $exception ) {
+                return false;
+            }
+
+            return false;
+        }
+
+        protected function parse_version_from_file( $file ) {
+            if ( ! file_exists( $file ) || ! is_readable( $file ) ) {
+                return '';
+            }
+            $head = file_get_contents( $file, false, null, 0, 8192 );
+            return is_string( $head ) ? $this->parse_version_from_string( $head ) : '';
+        }
+
+        protected function parse_version_from_string( $content ) {
+            if ( preg_match( '/^[ \t\/*#@]*Version:\s*([0-9A-Za-z\.\-_+]+)/mi', (string) $content, $match ) ) {
+                return trim( $match[1] );
+            }
+            return '';
+        }
+
+        protected function cleanup_path( $path ) {
+            global $wp_filesystem;
+            if ( is_object( $wp_filesystem ) ) {
+                $wp_filesystem->delete( $path, true );
+            }
+        }
+
+        protected function error_info( $message ) {
+            return array(
+                'latest_version' => '',
+                'main_sha256'    => '',
+                'changelog'      => '',
+                'source_key'     => '',
+                'error'          => (string) $message,
+                'checked_at'     => time(),
+            );
+        }
+
+        protected function result_error( $message ) {
+            return array(
+                'success' => false,
+                'message' => (string) $message,
+            );
+        }
+    }
+}
